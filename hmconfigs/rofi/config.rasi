@theme "/usr/share/rofi/themes/dmenu.rasi"

* {
    background-color:      Black;
    border-color:          Black;
    text-color:           Gold;
		font: "Noto Sans Mono 10";

}
window {
    anchor:     north;
    location:   north;
    width:      100%;
    padding:    10px;
    children:   [ horibox ];
}

prompt {
    text-color: transparent;
}

element selected {
    background-color: Gold;
    text-color: black;
}
